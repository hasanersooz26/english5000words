<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kelime Avcısı"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#102A43" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="15dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvCurrentLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Genel İlerleme: 0 / 150"
                android:textColor="#4A90E2"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/levelProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="10dp"
                android:progress="0"
                android:progressTint="#4CAF50" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnLearn"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_marginTop="30dp"
        android:text="Bölüm Seçerek Öğren"
        android:backgroundTint="#4A90E2"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:cornerRadius="15dp" />

    <Button
        android:id="@+id/btnQuiz"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_marginTop="12dp"
        android:text="Quiz Yap"
        android:backgroundTint="#4CAF50"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:cornerRadius="15dp" />

    <Button
        android:id="@+id/btnErrorReview"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_marginTop="12dp"
        android:text="Hatalı Kelimeler (0)"
        android:backgroundTint="#F44336"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:visibility="gone"
        app:cornerRadius="15dp" />

    <Button
        android:id="@+id/btnSpecial"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_marginTop="12dp"
        android:text="Özel Bölüm"
        android:backgroundTint="#9C27B0"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:cornerRadius="15dp" />

</LinearLayout>