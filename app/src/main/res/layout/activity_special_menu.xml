<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8"
    android:padding="20dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Özel Çalışma Alanı"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#9C27B0"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnSpecialLearn"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginBottom="12dp"
        android:text="Özel Kelime Avcısı"
        android:backgroundTint="#4CAF50"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:cornerRadius="15dp" />

    <Button
        android:id="@+id/btnReading"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginBottom="12dp"
        android:text="Reading Quiz"
        android:backgroundTint="#FF9800"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:cornerRadius="15dp" />

    <Button
        android:id="@+id/btnVocabulary"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginBottom="12dp"
        android:text="Vocabulary Quiz"
        android:backgroundTint="#03A9F4"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:cornerRadius="15dp" />

    <Button
        android:id="@+id/btnGrammar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Grammar Quiz"
        android:backgroundTint="#E91E63"
        android:layout_marginBottom="25dp"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:cornerRadius="15dp" />

    <Button
        android:id="@+id/btnSpecialMistakes"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Hatalı Soruları Çöz"
        android:backgroundTint="#F44336"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:cornerRadius="15dp" />

</LinearLayout>