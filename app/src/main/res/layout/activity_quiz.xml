<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8"
    android:padding="20dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ProgressBar
                android:id="@+id/quizProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:progressTint="#4CAF50"
                android:progressBackgroundTint="#DCE2E7"
                android:progress="0"
                android:max="10" />

            <TextView
                android:id="@+id/tvQuizProgressInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="1 / 10"
                android:textColor="#4A90E2"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvQuizWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Soru Kelimesi"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="#102A43"
                android:gravity="center" />

            <View
                android:layout_width="60dp"
                android:layout_height="4dp"
                android:background="#F0F4F8"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnOpt1"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textColor="#102A43"
            android:backgroundTint="#FFFFFF"
            android:stateListAnimator="@null"
            app:cornerRadius="18dp"
            app:strokeColor="#DCE2E7"
            app:strokeWidth="1.5dp"
            android:elevation="4dp" />

        <Button
            android:id="@+id/btnOpt2"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textColor="#102A43"
            android:backgroundTint="#FFFFFF"
            android:stateListAnimator="@null"
            app:cornerRadius="18dp"
            app:strokeColor="#DCE2E7"
            app:strokeWidth="1.5dp"
            android:elevation="4dp" />

        <Button
            android:id="@+id/btnOpt3"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textColor="#102A43"
            android:backgroundTint="#FFFFFF"
            android:stateListAnimator="@null"
            app:cornerRadius="18dp"
            app:strokeColor="#DCE2E7"
            app:strokeWidth="1.5dp"
            android:elevation="4dp" />

        <Button
            android:id="@+id/btnOpt4"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textColor="#102A43"
            android:backgroundTint="#FFFFFF"
            android:stateListAnimator="@null"
            app:cornerRadius="18dp"
            app:strokeColor="#DCE2E7"
            app:strokeWidth="1.5dp"
            android:elevation="4dp" />
    </LinearLayout>

</LinearLayout>